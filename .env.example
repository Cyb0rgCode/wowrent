# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/wowrent?schema=public"

# Secret used to sign session JWTs (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-secret"

# Public base URL of the app (used to build Konnect return URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Konnect (Tunisian payment gateway) ---
# Sandbox: https://api.sandbox.konnect.network/api/v2
# Production: https://api.konnect.network/api/v2
KONNECT_API_URL="https://api.sandbox.konnect.network/api/v2"
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
# Platform commission taken from each booking (percentage, e.g. 0.10 = 10%)
PLATFORM_COMMISSION_RATE="0.10"
# Same rate exposed to the browser for the live price estimate
NEXT_PUBLIC_COMMISSION_RATE="0.10"
